// prisma/lesson.prisma

// Odpowiednik PersonaType ('starter' | 'family').
// Jeśli ten enum masz już w auth.prisma, usuń go stąd.
enum PersonaType {
  starter
  family
}

// Odpowiednik discriminatora `type` w LessonStep
enum StepType {
  story
  concept
  decision
  summary
  matching
}

// Odpowiednik LessonStatus
enum LessonStatus {
  locked
  active
  completed
}

// Temat = ścieżka nauki (zakładka na mapie lekcji). Temat ma rozdziały, a rozdział lekcje.
model Topic {
  id          String @id @default(cuid())
  topicTitle  String

  Chapter     Chapter[]
}

model Chapter {
  id           String   @id @default(cuid())
  topicId      String
  orderNumber  Int
  chapterTitle String

  Lessons      Lesson[]
  Topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// Lekcja (odpowiednik interfejsu Lesson)
model Lesson {
  id               String  @id @default(cuid())
  order            Int
  chapterId        String
  title            String
  description      String  @db.Text
  estimatedMinutes Int
  experience       Int     @default(0) @db.UnsignedInt

  // Zasób odblokowywany po ukończeniu lekcji (opcjonalny).
  unlockAssetId    String?

  targetPersonas   LessonPersona[]
  steps            LessonStep[]
  progress         UserLessonProgress[]

  chapter          Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([order])
}

// Odpowiednik targetPersonas: PersonaType[]
// (MySQL nie obsługuje list enumów, więc osobna tabela)
model LessonPersona {
  lessonId String
  // Ile przeszedł kroków ?
  // Czy zakończył czy nie 
  persona  PersonaType
  lesson   Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, persona])
}

// Krok lekcji. Jedna tabela na wszystkie 5 typów kroków:
// wypełnione są tylko pola pasujące do `type`, reszta zostaje NULL.
//
//   story    -> narrative
//   concept  -> explanation, keyTakeaway
//   decision -> scenario + options (tabela DecisionOption)
//   summary  -> summary, keyTakeaways
//   matching -> pairs (Json: [{ term, definition }])
model LessonStep {
  id       String   @id @default(cuid())
  lessonId String
  order    Int      // kolejność kroku w lekcji
  type     StepType
  title    String

  narrative    String? @db.Text
  explanation  String? @db.Text
  keyTakeaway  String? @db.Text
  scenario     String? @db.Text
  summary      String? @db.Text
  keyTakeaways Json?
  pairs        Json?

  options DecisionOption[]
  lesson  Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

// Opcja w kroku typu "decision"
model DecisionOption {
  id        String  @id @default(cuid())
  stepId    String
  order     Int
  label     String
  isOptimal Boolean @default(false)
  feedback  String  @db.Text

  step LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

// Status lekcji jest osobny dla każdego użytkownika,
// dlatego nie ma go w modelu Lesson
model UserLessonProgress {
  userId      String
  lessonId    String
  status      LessonStatus @default(locked)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}