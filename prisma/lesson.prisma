// prisma/lesson.prisma

// Odpowiednik PersonaType ('starter' | 'family').
// Jeśli ten enum masz już w auth.prisma, usuń go stąd.
enum PersonaType {
  starter
  family
}

// Odpowiednik discriminatora `type` w LessonStep
enum StepType {
  story
  concept
  decision
  summary
  matching
  growth
  budget
  risk
  estimate
}

// Odpowiednik LessonStatus
enum LessonStatus {
  locked
  active
  completed
}

// Temat = ścieżka nauki (zakładka na mapie lekcji). Temat ma rozdziały, a rozdział lekcje.
model Topic {
  id          String @id @default(cuid())
  topicTitle  String

  Chapter     Chapter[]
}

model Chapter {
  id           String   @id @default(cuid())
  topicId      String
  orderNumber  Int
  chapterTitle String

  Lessons      Lesson[]
  Topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// Lekcja (odpowiednik interfejsu Lesson)
model Lesson {
  id               String  @id @default(cuid())
  order            Int
  chapterId        String
  title            String
  description      String  @db.Text
  estimatedMinutes Int
  experience       Int     @default(0) @db.UnsignedInt

  // Zasób odblokowywany po ukończeniu lekcji (opcjonalny).
  unlockAssetId    String?

  targetPersonas   LessonPersona[]
  steps            LessonStep[]
  progress         UserLessonProgress[]

  chapter          Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([order])
}

// Odpowiednik targetPersonas: PersonaType[]
// (MySQL nie obsługuje list enumów, więc osobna tabela)
model LessonPersona {
  lessonId String
  // Ile przeszedł kroków ?
  // Czy zakończył czy nie 
  persona  PersonaType
  lesson   Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, persona])
}

// Krok lekcji. Wspólne kolumny + jeden Json `data`, którego kształt zależy od `type`
// (dokładny opis: types/step-data.ts, walidacja: lib/lesson/step-parser.ts):
//
//   story    -> { narrative }
//   concept  -> { explanation, keyTakeaway }
//   decision -> { scenario, options: [{ id, label, isOptimal, feedback }] }
//   summary  -> { summary, keyTakeaways: string[] }
//   matching -> { pairs: [{ term, definition }] }
//   growth / budget / risk / estimate -> konfiguracja zadania (types/interactive.ts)
model LessonStep {
  id       String   @id @default(cuid())
  lessonId String
  order    Int      // kolejność kroku w lekcji
  type     StepType
  title    String
  data     Json

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

// Status lekcji jest osobny dla każdego użytkownika,
// dlatego nie ma go w modelu Lesson
model UserLessonProgress {
  userId      String
  lessonId    String
  status      LessonStatus @default(locked)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}